{
  "id": "hexa",
  "name": "Hexa",
  "requires": 4,
  "description": "HLS from several servers with English audio, needs a TMDB id",
  "rank": 110,
  "defaultEnabled": true,
  "credits": [
    {
      "author": "smy778",
      "project": "EncDecEndpoints",
      "url": "https://github.com/smy778/EncDecEndpoints",
      "source": "samples/hexa.py",
      "license": "MIT",
      "note": "The request chain and headers follow the public sample. The enc-dec.app API solves the site's challenge and decrypts the reply. The sample sends a random 32-byte hex key; the site accepts any fixed 64-character hex key, so this recipe sends one."
    }
  ],
  "vars": {
    "site": "https://hexa.su",
    "api": "https://theemoviedb.hexa.su/api/tmdb",
    "cap": "https://cap.hexa.su/15d2cf0395",
    "enc": "https://enc-dec.app/api",
    "key": "3f9a1c7e5b2d48a0916c0e7d4b8a2f5133c6e9d07a41b85fc2e6d19a0b7f3c58",
    "ua": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36",
    "capUa": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36 OPR/129.0.0.0 (Edition std-2)"
  },
  "steps": [
    {
      "op": "set",
      "as": "tmdbId",
      "value": "{{tmdb | digits}}"
    },
    {
      "op": "require",
      "value": "{{tmdbId}}",
      "msg": "no tmdb id"
    },
    {
      "op": "set",
      "as": "path",
      "value": "/movie/{{tmdbId}}/images"
    },
    {
      "op": "set",
      "as": "season",
      "value": "{{id | split:':' | at:1}}",
      "when": {
        "value": "{{type}}",
        "equals": "series"
      }
    },
    {
      "op": "set",
      "as": "episode",
      "value": "{{id | split:':' | at:2}}",
      "when": {
        "value": "{{type}}",
        "equals": "series"
      }
    },
    {
      "op": "require",
      "value": "{{season}}",
      "msg": "series without season",
      "when": {
        "value": "{{type}}",
        "equals": "series"
      }
    },
    {
      "op": "require",
      "value": "{{episode}}",
      "msg": "series without episode",
      "when": {
        "value": "{{type}}",
        "equals": "series"
      }
    },
    {
      "op": "set",
      "as": "path",
      "value": "/tv/{{tmdbId}}/season/{{season}}/episode/{{episode}}/images",
      "when": {
        "value": "{{type}}",
        "equals": "series"
      }
    },
    {
      "op": "post",
      "url": "{{cap}}/challenge",
      "headers": {
        "accept-language": "en-US,en;q=0.9",
        "origin": "{{site}}",
        "referer": "{{site}}/",
        "user-agent": "{{capUa}}"
      },
      "response": "json",
      "as": "challenge"
    },
    {
      "op": "require",
      "value": "{{challenge.token}}",
      "msg": "no challenge from the site"
    },
    {
      "op": "post",
      "url": "{{enc}}/enc-hexa",
      "headers": {
        "User-Agent": "{{ua}}"
      },
      "body": {
        "challenge_data": "{{challenge}}"
      },
      "response": "json",
      "as": "solved"
    },
    {
      "op": "require",
      "value": "{{solved.result}}",
      "msg": "enc-hexa did not solve the challenge"
    },
    {
      "op": "post",
      "url": "{{cap}}/redeem",
      "headers": {
        "accept-language": "en-US,en;q=0.9",
        "origin": "{{site}}",
        "referer": "{{site}}/",
        "user-agent": "{{capUa}}"
      },
      "body": "{{solved.result}}",
      "response": "json",
      "as": "redeemed"
    },
    {
      "op": "require",
      "value": "{{redeemed.token}}",
      "msg": "the site gave no token"
    },
    {
      "op": "get",
      "url": "{{api}}{{path}}",
      "headers": {
        "User-Agent": "{{ua}}",
        "Referer": "{{site}}/",
        "Accept": "text/plain",
        "X-Fingerprint-Lite": "e9136c41504646444",
        "X-Cap-Token": "{{redeemed.token}}",
        "X-Api-Key": "{{key}}"
      },
      "as": "blob"
    },
    {
      "op": "post",
      "url": "{{enc}}/dec-hexa",
      "headers": {
        "User-Agent": "{{ua}}"
      },
      "body": {
        "text": "{{blob}}",
        "key": "{{key}}"
      },
      "response": "json",
      "as": "dec"
    },
    {
      "op": "set",
      "as": "info",
      "value": "{{dec.result | json}}"
    },
    {
      "op": "require",
      "value": "{{info.sources}}",
      "msg": "hexa returned no sources"
    },
    {
      "op": "foreach",
      "in": "{{info.sources}}",
      "as": "src",
      "steps": [
        {
          "op": "emit",
          "stream": {
            "title": "Hexa - {{src.server | capitalize}}",
            "url": "{{src.url}}",
            "format": "hls",
            "headers": {
              "User-Agent": "{{ua}}",
              "Referer": "{{site}}/",
              "Origin": "{{site}}"
            }
          }
        }
      ]
    }
  ]
}
